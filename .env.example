# Copy this file to .env and fill in real values before going live.
# Values below are safe DEMO PLACEHOLDERs for local development only.
#
# Business identity (name, tagline, WhatsApp number, brand colors, etc.) is
# NOT read from env vars — it lives in src/lib/business.config.ts, a plain
# TypeScript file, so it's easy to review/edit and type-checked. Edit that
# file directly for the real business's details.

# --- App URL (used for payment callback/redirect URLs) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Database (Postgres — Neon in production, provisioned via the Vercel
# Marketplace integration; point at any Postgres instance for local dev) ---
# `DATABASE_URL_UNPOOLED` is the direct (non-pgbouncer) connection, used
# only for running migrations — see prisma/schema.prisma `directUrl`.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

# --- Payments ---
# Leave unset (or keep the DEMO_PLACEHOLDER prefix) to use the in-app demo
# payment simulator instead of real Paystack. Get real keys from
# https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY="DEMO_PLACEHOLDER"
PAYSTACK_PUBLIC_KEY="DEMO_PLACEHOLDER"

# --- Admin auth ---
# Signs admin session JWTs. Generate a real one with: openssl rand -base64 32
# The default below is a demo-only placeholder — env.server.ts refuses to
# start with it in a Vercel production deployment.
AUTH_SECRET="DEMO_PLACEHOLDER_AUTH_SECRET_DO_NOT_USE_IN_PRODUCTION"

# --- One-off seed endpoint (see src/app/api/admin/seed/route.ts) ---
# Leave unset to disable the route entirely (it 404s with no secret set).
SEED_SECRET=
