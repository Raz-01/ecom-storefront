# Copy this file to .env and fill in real values before going live.
# Values below are safe DEMO PLACEHOLDERs for local development only.

# --- Business identity (shown in UI, used to build WhatsApp links) ---
NEXT_PUBLIC_BUSINESS_NAME="Demo Store"
# E.164 international format, digits only, no leading "+". e.g. 2348012345678
NEXT_PUBLIC_WHATSAPP_NUMBER="2340000000000"
NEXT_PUBLIC_CURRENCY="NGN"

# --- App URL (used for payment callback/redirect URLs) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Database (SQLite for local dev; switch to Postgres in production) ---
DATABASE_URL="file:./dev.db"

# --- Payments ---
# Leave unset (or keep the DEMO_PLACEHOLDER prefix) to use the in-app demo
# payment simulator instead of real Paystack. Get real keys from
# https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY="DEMO_PLACEHOLDER"
PAYSTACK_PUBLIC_KEY="DEMO_PLACEHOLDER"
