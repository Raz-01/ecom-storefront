// Prisma schema for the storefront.
//
// Datasource is Postgres (Vercel Postgres in production; point DATABASE_URL
// at any Postgres instance for local dev — see .env.example).
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// A product category, used for storefront navigation/filtering.
model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// A sellable product. Price is stored in minor currency units (e.g. kobo)
/// as an integer to avoid floating-point rounding errors in money math.
model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String
  priceMinor  Int // price in minor units (e.g. kobo for NGN)
  imageUrl    String?
  stock       Int         @default(0)
  isActive    Boolean     @default(true)
  category    Category    @relation(fields: [categoryId], references: [id])
  categoryId  String
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([categoryId])
}

/// A delivery zone with a flat fee. Real businesses price delivery by
/// area, not a single hardcoded number — this table is the seam that lets
/// that vary without a code change. Seed with real zones/fees before launch.
model DeliveryZone {
  id             String   @id @default(cuid())
  name           String   @unique
  feeMinor       Int
  isActive       Boolean  @default(true)
  orders         Order[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PAYMENT_FAILED
  CANCELLED
  FULFILLED
}

/// A customer order. Money fields are snapshots computed server-side at
/// creation time (never trusted from the client) so the order remains an
/// accurate record even if product prices change later.
model Order {
  id         String      @id @default(cuid())
  orderNumber String     @unique

  customerName  String
  customerPhone String
  customerEmail String?

  deliveryZone   DeliveryZone @relation(fields: [deliveryZoneId], references: [id])
  deliveryZoneId String
  deliveryAddress String

  subtotalMinor    Int
  deliveryFeeMinor Int
  totalMinor       Int

  status OrderStatus @default(PENDING_PAYMENT)

  paymentProvider  String? // e.g. "paystack" | "demo"
  paymentReference String? @unique
  paidAt           DateTime?

  stockRestored Boolean @default(false) // guards against double-restoring inventory

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([customerPhone])
}

/// A line item snapshot — product name/price are copied at order time so
/// the order stays accurate even if the product is later edited or removed.
model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String

  productName     String
  unitPriceMinor  Int
  quantity        Int
  lineTotalMinor  Int

  @@index([orderId])
}
